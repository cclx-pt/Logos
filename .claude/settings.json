{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "engineering-skills@claude-code-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm dev)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",

      "Bash(npx shadcn*)",
      "Bash(npx supabase *)",

      "Bash(supabase status)",
      "Bash(supabase migration *)",
      "Bash(supabase db push *)",
      "Bash(supabase db diff *)",
      "Bash(supabase db reset *)",
      "Bash(supabase functions *)",
      "Bash(supabase gen types *)",
      "Bash(supabase login)",
      "Bash(supabase link *)",
      "Bash(supabase start)",
      "Bash(supabase stop)",

      "Bash(vercel ls*)",
      "Bash(vercel env *)",
      "Bash(vercel link *)",
      "Bash(vercel pull *)",
      "Bash(vercel logs*)",
      "Bash(vercel inspect*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(git remote*)",

      "Bash(gh auth *)",
      "Bash(gh pr *)",
      "Bash(gh repo view*)",
      "Bash(gh repo clone *)",
      "Bash(gh issue *)",
      "Bash(gh workflow *)",
      "Bash(gh run *)",
      "Bash(gh api *)",

      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *--force *)",
      "Bash(git push *-f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *main*)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase projects delete*)",
      "Bash(vercel remove*)",
      "Bash(gh repo delete*)"
    ]
  }
}
