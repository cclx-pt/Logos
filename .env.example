# =============================================================
# Logos — Variáveis de Ambiente (exemplo)
# Copia este ficheiro para `.env.local` e preenche os valores.
# NUNCA fazer commit de `.env.local` ou `.env` com valores reais.
# =============================================================

# ---- Aplicação ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Logos

# ---- Supabase (Postgres + Auth + Storage) ----
# Painel: https://app.supabase.com  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Chave de service role: APENAS no servidor. Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase Storage ----
# Nome do bucket onde os PDFs das aulas ficam guardados.
SUPABASE_STORAGE_BUCKET=lesson-pdfs

# ---- Resend (emails transacionais) ----
# Painel: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Logos <no-reply@logos.cclx.pt>

# ---- Google OAuth (configurado via Supabase Auth) ----
# Estes valores são definidos no painel da Supabase, não aqui.
# Mantidos como referência caso se faça override local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Sentry (V2+, opcional) ----
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ---- Vercel (preenchido automaticamente em produção) ----
# VERCEL_URL=
# VERCEL_ENV=
