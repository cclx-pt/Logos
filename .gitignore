# =============================================================
# Logos — .gitignore
# =============================================================

# ---- Dependências ----
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz

# ---- Next.js ----
.next/
out/
build/
dist/

# ---- Produção / Deploy ----
.vercel/

# ---- Variáveis de ambiente ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Testes / Cobertura ----
coverage/
*.lcov
.nyc_output/

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- IDE / Editor ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- Claude Code (config local por máquina) ----
.claude/settings.local.json
.claude/worktrees/

# ---- Outras ferramentas de agentes (config local por máquina) ----
.agents/
.codex/

# ---- Notas pessoais soltas (não fazem parte do projeto) ----
claude-code-psb-guide.md

# ---- SO ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Supabase local ----
supabase/.branches
supabase/.temp
supabase/migrations/*.sql.bak
supabase/seed/*.sql
!supabase/seed/*.sql.example

# ---- Diversos ----
*.pem
.turbo/
.cache/
.vercel

# ---- ffmpeg.wasm core (copiado de node_modules por scripts/copy-ffmpeg-core.mjs) ----
/public/ffmpeg/
