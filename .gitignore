# =============================================================
# Logos — .gitignore
# =============================================================

# ---- Dependências ----
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz

# ---- Next.js ----
.next/
out/
build/
dist/

# ---- Produção / Deploy ----
.vercel/

# ---- Variáveis de ambiente ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Testes / Cobertura ----
coverage/
*.lcov
.nyc_output/

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- IDE / Editor ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- Claude Code (config local por máquina) ----
.claude/settings.local.json

# ---- SO ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Supabase local ----
supabase/.branches
supabase/.temp
supabase/migrations/*.sql.bak

# ---- Diversos ----
*.pem
.turbo/
.cache/
